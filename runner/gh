#!/bin/sh
# gh for the CI jobs on this PC: runner/install.ps1 copies it to ~/actions-runner/bin, first on the jobs' PATH.
# It runs the real gh and retries when the connection to GitHub failed before the request went out:
# a TLS handshake timeout, a refused connect or a host name that didn't resolve. Such a failure stopped skyaltar releases on 2026-11-10.
# Any other failure, a 4xx or 5xx included, returns at once, so a POST never runs twice.
real=
IFS=:
# -ef skips this file by identity with no subshell: a cd per PATH folder cost 0.5 s on each call.
# shellcheck disable=SC3013 # Git Bash and dash both have -ef.
for dir in $PATH; do
  for name in gh.exe gh; do
    [ -x "$dir/$name" ] && [ ! -d "$dir/$name" ] && [ ! "$dir/$name" -ef "$0" ] && real="$dir/$name" && break 2
  done
done
unset IFS
[ -n "$real" ] || {
  echo "gh: no gh found on PATH apart from $0" >&2
  exit 127
}
# Input from stdin can't be read twice, so such a call runs once: -, --input=- and a field such as body=@-.
for arg in "$@"; do
  case $arg in - | *=- | *@-) exec "$real" "$@" ;; esac
done
err=$(mktemp)
trap 'rm -f "$err"' EXIT
wait=10
for try in 1 2 3 4; do
  "$real" "$@" 2>"$err"
  code=$?
  cat "$err" >&2
  [ "$code" = 0 ] && exit 0
  # gh prints "error connecting to <host>" in place of the DNS error.
  grep -qE 'TLS handshake timeout|dial tcp|connectex|no such host|^error connecting to ' "$err" || exit "$code"
  [ "$try" = 4 ] && exit "$code"
  echo "gh: no connection to GitHub, try $((try + 1)) of 4 in ${wait}s" >&2
  sleep "$wait"
  wait=$((wait * 2))
done
